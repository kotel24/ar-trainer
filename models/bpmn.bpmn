<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_internship" targetNamespace="https://github.com/kotel24/ar-trainer">
  <bpmn:collaboration id="Collaboration_internship">
    <bpmn:participant id="P_internship" name="Стажировка на рабочем месте (станок 2Н135)" processRef="Process_internship" />
    <bpmn:participant id="P_safety" name="Технолог или учебный центр" />
    <bpmn:messageFlow id="M_program" name="Программа стажировки" sourceRef="P_safety" targetRef="T_order" />
  </bpmn:collaboration>
  <bpmn:process id="Process_internship" isExecutable="false">
    <bpmn:laneSet id="LaneSet_internship">
      <bpmn:lane id="L_master" name="Мастер участка">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_skills</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_extend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_admit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_mentor" name="Наставник">
        <bpmn:flowNodeRef>T_intro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_mergeA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_mergeB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_danger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_term</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_concl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_trainee" name="Стажёр">
        <bpmn:flowNodeRef>T_watch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_self</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Работник прошёл первичный инструктаж">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_order" name="Оформить распоряжение о стажировке">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="A_DO_order"><bpmn:targetRef>R_DO_order</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T_intro" name="Ознакомить стажёра с программой и опасными зонами">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_mergeA">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_mergeB">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_show" name="Показать операцию на станке">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_watch" name="Выполнить операцию под наблюдением">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_check" name="Проверить действия стажёра">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_danger" name="Опасная ошибка?">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_stop" name="Остановить стажёра и объяснить ошибку">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_term" name="Срок по программе истёк?">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_self" name="Выполнить операцию самостоятельно">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_eval" name="Оценить навыки стажёра">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_mark" name="Сделать отметку о прохождении стажировки">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="A_DO_log"><bpmn:targetRef>R_DO_log</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T_concl" name="Составить заключение">
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="A_DO_concl"><bpmn:targetRef>R_DO_concl</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_skills" name="Навыки достаточны?">
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_extend" name="Продлить стажировку">
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_admit" name="Оформить допуск к самостоятельной работе">
      <bpmn:incoming>F_18</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="A_DO_admit"><bpmn:targetRef>R_DO_admit</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Работник допущен к самостоятельной работе">
      <bpmn:incoming>F_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="Start" targetRef="T_order" />
    <bpmn:sequenceFlow id="F_2" sourceRef="T_order" targetRef="T_intro" />
    <bpmn:sequenceFlow id="F_3" sourceRef="T_intro" targetRef="G_mergeA" />
    <bpmn:sequenceFlow id="F_4" sourceRef="G_mergeA" targetRef="G_mergeB" />
    <bpmn:sequenceFlow id="F_5" sourceRef="G_mergeB" targetRef="T_show" />
    <bpmn:sequenceFlow id="F_6" sourceRef="T_show" targetRef="T_watch" />
    <bpmn:sequenceFlow id="F_7" sourceRef="T_watch" targetRef="T_check" />
    <bpmn:sequenceFlow id="F_8" sourceRef="T_check" targetRef="G_danger" />
    <bpmn:sequenceFlow id="F_9" name="да" sourceRef="G_danger" targetRef="T_stop" />
    <bpmn:sequenceFlow id="F_10" sourceRef="T_stop" targetRef="G_mergeB" />
    <bpmn:sequenceFlow id="F_11" name="нет" sourceRef="G_danger" targetRef="G_term" />
    <bpmn:sequenceFlow id="F_12" name="нет" sourceRef="G_term" targetRef="T_watch" />
    <bpmn:sequenceFlow id="F_13" name="да" sourceRef="G_term" targetRef="T_self" />
    <bpmn:sequenceFlow id="F_14" sourceRef="T_self" targetRef="T_eval" />
    <bpmn:sequenceFlow id="F_15" sourceRef="T_eval" targetRef="T_mark" />
    <bpmn:sequenceFlow id="F_16" sourceRef="T_mark" targetRef="T_concl" />
    <bpmn:sequenceFlow id="F_17" sourceRef="T_concl" targetRef="G_skills" />
    <bpmn:sequenceFlow id="F_18" name="да" sourceRef="G_skills" targetRef="T_admit" />
    <bpmn:sequenceFlow id="F_19" name="нет" sourceRef="G_skills" targetRef="T_extend" />
    <bpmn:sequenceFlow id="F_20" sourceRef="T_extend" targetRef="G_mergeA" />
    <bpmn:sequenceFlow id="F_21" sourceRef="T_admit" targetRef="End" />
    <bpmn:dataObject id="DO_order" />
    <bpmn:dataObjectReference id="R_DO_order" name="Распоряжение о стажировке" dataObjectRef="DO_order" />
    <bpmn:dataObject id="DO_log" />
    <bpmn:dataObjectReference id="R_DO_log" name="Журнал стажировки" dataObjectRef="DO_log" />
    <bpmn:dataObject id="DO_concl" />
    <bpmn:dataObjectReference id="R_DO_concl" name="Заключение наставника" dataObjectRef="DO_concl" />
    <bpmn:dataObject id="DO_admit" />
    <bpmn:dataObjectReference id="R_DO_admit" name="Распоряжение о допуске" dataObjectRef="DO_admit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_internship">
    <bpmndi:BPMNPlane id="Plane_internship" bpmnElement="Collaboration_internship">
      <bpmndi:BPMNShape id="P_internship_di" bpmnElement="P_internship" isHorizontal="true"><dc:Bounds x="100" y="140" width="2300" height="620" /></bpmndi:BPMNShape>
