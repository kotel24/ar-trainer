      <bpmndi:BPMNEdge id="F_1_di" bpmnElement="F_1"><di:waypoint x="212" y="270" /><di:waypoint x="240" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_2_di" bpmnElement="F_2"><di:waypoint x="310" y="320" /><di:waypoint x="310" y="640" /></bpmndi:BPMNEdge>
