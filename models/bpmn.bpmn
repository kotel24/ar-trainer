      <bpmndi:BPMNShape id="R_DO_order_di" bpmnElement="R_DO_order"><dc:Bounds x="202" y="430" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="155" y="485" width="130" height="38" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
